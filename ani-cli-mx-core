stable_unique_lines() {
    unique_lines_seen=""
    while IFS= read -r unique_line || [ -n "$unique_line" ]; do
        unique_line_seen=0
        unique_lines_old_ifs=$IFS
        IFS='
'
        for seen_line in $unique_lines_seen; do
            [ "$seen_line" = "$unique_line" ] && unique_line_seen=1 && break
        done
        IFS=$unique_lines_old_ifs
        [ "$unique_line_seen" = "1" ] && continue
        printf '%s\n' "$unique_line"
        unique_lines_seen="${unique_lines_seen}${unique_line}
"
    done
}

