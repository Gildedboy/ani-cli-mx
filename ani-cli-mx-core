process_hist_entry() {
    ep_list=$(episodes_list "$id" "$title")
    latest_ep=$(printf "%s\n" "$ep_list" | tail -n1)
    title=$(printf "%s\n" "$title" | sed "s|[0-9]\+ episodios|${latest_ep} episodios|")
    ep_no=$(printf "%s" "$ep_list" | sed -n "/^${ep_no}$/{n;p;}") 2>/dev/null
    [ -n "$ep_no" ] && printf "%s\t%s - episodio %s\n" "$id" "$title" "$ep_no"
}

last_watched_episode_for_current_anime() {
    [ -f "$histfile" ] || return 0
    awk -F '	' -v target="$id" '$2 == target { print $1; exit }' "$histfile"
}

select_episode() {
    stdin=$(cat -)
    [ -z "$stdin" ] && return 1
    line_count="$(printf "%s\n" "$stdin" | wc -l | tr -d "[:space:]")"
    [ "$line_count" -eq 1 ] && printf "%s" "$stdin" && return 0

    last_watched_ep="$(last_watched_episode_for_current_anime)"
    if [ -n "$last_watched_ep" ] && ! printf "%s\n" "$stdin" | awk -v last_ep="$last_watched_ep" '$0 == last_ep { found = 1 } END { exit !found }'; then
        last_watched_ep=""
    fi
    prompt="Selecciona episodio: "
    [ -n "$last_watched_ep" ] && prompt="Selecciona episodio (* ultimo visto): "
    menu_entries="$(printf "%s\n" "$stdin" | awk -v last_ep="$last_watched_ep" '
        last_ep != "" && $0 == last_ep { print $0 " *"; next }
        { print }
    ')"
    selection="$(printf "%s" "$menu_entries" | launcher "$multi_selection_flag" "$prompt")"
    selected_eps="$(printf "%s\n" "$selection" | sed 's/[[:space:]].*$//')"
    [ -n "$selected_eps" ] || exit 1

    line_start=$(printf "%s" "$selected_eps" | head -n1)
    line_end=$(printf "%s" "$selected_eps" | tail -n1)
    if [ "$line_start" = "$line_end" ]; then
        printf "%s" "$line_start"
    else
        printf "%s\n" "$stdin" | awk -v start="$line_start" -v end="$line_end" '
            $0 == start { printing = 1 }
            printing { print }
            $0 == end { exit }
        '
    fi
}

update_history() {
    awk -F '	' -v OFS='	' -v target="$id" -v new_ep="$ep_no" -v new_title="$title" '
        BEGIN { updated = 0 }
        $2 == target {
            $1 = new_ep
            $3 = new_title
            updated = 1
        }
        NF { print }
        END {
            if (!updated) {
                print new_ep, target, new_title
            }
        }
    ' "$histfile" >"${histfile}.new"
    mv "${histfile}.new" "$histfile"
}

download() {
    prepare_download
    download_referrer="${generic_refr:-$animeflv_refr}"
    # download subtitle if it's set
    [ -n "$subtitle" ] && curl -s "$subtitle" -o "$download_dir/$2.vtt"
    case $1 in
        *m3u8*)
            if command -v "yt-dlp" >/dev/null; then
                yt-dlp --referer "$download_referrer" "$1" --no-skip-unavailable-fragments --fragment-retries infinite -N 16 -o "$download_dir/$2.mp4"
            else
                ffmpeg -extension_picky 0 -referer "$download_referrer" -loglevel error -stats -i "$1" -c copy "$download_dir/$2.mp4"
            fi
            # embed subs into downloads
            # [ -e "$download_dir/$2.vtt" ] && ffmpeg -i "$download_dir/$2.mp4" -i "$download_dir/$2.vtt" -c copy -c:s mov_text "$download_dir/$2.bak.mp4" && mv "$download_dir/$2.bak.mp4" "$download_dir/$2.mp4"
            ;;
        *)
            # shellcheck disable=SC2086
            aria2c --referer="$download_referrer" --enable-rpc=false --check-certificate=false --continue $iSH_DownFix --summary-interval=0 -x 16 -s 16 "$1" --dir="$download_dir" -o "$2.mp4" --download-result=hide
            ;;
    esac
}

create_mpv_window_state_script() {
    printf '%s\n' \
        "local state_path = [[$mpv_window_state_player_file]]" \
        'local state = { fullscreen = false, maximized = false }' \
        'local function save_state()' \
        '    local file = io.open(state_path, "w")' \
        '    if not file then return end' \
        '    file:write("fullscreen=" .. (state.fullscreen and "yes" or "no") .. "\n")' \
        '    file:write("maximized=" .. (state.maximized and "yes" or "no") .. "\n")' \
        '    if state.geometry then file:write("geometry=" .. state.geometry .. "\n") end' \
        '    file:close()' \
        'end' \
        'local function finalize_state()' \
        '    state.fullscreen = mp.get_property_native("fullscreen", state.fullscreen)' \
        '    state.maximized = mp.get_property_native("window-maximized", state.maximized)' \
        '    save_state()' \
        'end' \
        'mp.observe_property("fullscreen", "bool", function(_, value)' \
        '    if value ~= nil then state.fullscreen = value; save_state() end' \
        'end)' \
        'mp.observe_property("window-maximized", "bool", function(_, value)' \
        '    if value ~= nil then state.maximized = value; save_state() end' \
        'end)' \
        'mp.add_periodic_timer(0.25, function()' \
        '    if state.fullscreen or state.maximized then return end' \
        '    local width = mp.get_property_number("osd-width", 0)' \
        '    local height = mp.get_property_number("osd-height", 0)' \
        '    if width <= 0 or height <= 0 then return end' \
        '    local geometry = string.format("%dx%d", math.floor(width), math.floor(height))' \
        '    if geometry ~= state.geometry then state.geometry = geometry; save_state() end' \
        'end)' \
        'mp.register_event("shutdown", finalize_state)' >"$mpv_window_state_script"
}

create_mpv_session_controller() {
    printf '%s\n' \
        'local utils = require "mp.utils"' \
        "local command_path = [[$mpv_session_player_command_file]]" \
        "local event_path = [[$mpv_session_player_event_file]]" \
        "local owner_path = [[$mpv_session_player_owner_file]]" \
        "local controller_path = [[$mpv_session_player_controller_script]]" \
        "local state_path = [[$mpv_window_state_player_file]]" \
        "local state_script_path = [[$mpv_window_state_player_script]]" \
        'local current_episode = ""' \
        'local finished_episode = ""' \
        'local pending_subtitles = {}' \
        'local owner_gone = false' \
        'local function file_exists(path)' \
        '    local file = io.open(path, "r")' \
        '    if not file then return false end' \
        '    file:close()' \
        '    return true' \
        'end' \
        'local function write_event(value)' \
        '    local file = io.open(event_path, "w")' \
        '    if not file then return end' \
        '    file:write(value .. "\n")' \
        '    file:close()' \
        'end' \
        'local function mark_finished()' \
        '    if not owner_gone and current_episode ~= "" and finished_episode ~= current_episode then' \
        '        finished_episode = current_episode' \
        '        write_event(current_episode)' \
        '    end' \
        'end' \
        'local function process_command()' \
        '    local file = io.open(command_path, "r")' \
        '    if not file then return end' \
        '    local payload = file:read("*a")' \
        '    file:close()' \
        '    os.remove(command_path)' \
        '    local command = utils.parse_json(payload)' \
        '    if type(command) ~= "table" or command.action ~= "load" or not command.url then return end' \
        '    current_episode = tostring(command.episode or "")' \
        '    finished_episode = ""' \
        '    pending_subtitles = command.subtitles or {}' \
        '    mp.set_property("force-media-title", command.title or "")' \
        '    mp.set_property("referrer", command.referrer or "")' \
        '    mp.set_property("http-header-fields", command.headers or "")' \
        '    mp.commandv("loadfile", command.url, "replace")' \
        'end' \
        'mp.register_event("file-loaded", function()' \
        '    mp.set_property_native("pause", false)' \
        '    mp.add_timeout(0.1, function() mp.set_property_native("pause", false) end)' \
        '    for _, subtitle in ipairs(pending_subtitles) do mp.commandv("sub-add", subtitle, "auto") end' \
        '    pending_subtitles = {}' \
        'end)' \
        'mp.observe_property("eof-reached", "bool", function(_, value)' \
        '    if value then mark_finished() end' \
        'end)' \
        'mp.register_event("end-file", function(event)' \
        '    if not owner_gone and event.reason == "error" and current_episode ~= "" then write_event(current_episode) end' \
        'end)' \
        'mp.add_periodic_timer(0.1, function()' \
        '    if not owner_gone and not file_exists(owner_path) then' \
        '        owner_gone = true' \
        '        mp.set_property_native("keep-open", false)' \
        '        mp.set_property_native("idle", false)' \
        '    end' \
        '    process_command()' \
        '    if mp.get_property_native("eof-reached", false) then mark_finished() end' \
        'end)' \
        'mp.register_event("shutdown", function()' \
        '    os.remove(command_path)' \
        '    os.remove(event_path)' \
        '    os.remove(owner_path)' \
        '    os.remove(controller_path)' \
        '    os.remove(state_path)' \
        '    os.remove(state_script_path)' \
        'end)' >"$mpv_session_controller_script"
}

mpv_json_escape() {
    printf '%s' "$1" | sed \
        -e 's/\\/\\\\/g' \
        -e 's/"/\\"/g' \
        -e 's/\r/\\r/g' \
        -e 's/	/\\t/g'
}

