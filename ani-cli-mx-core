            done
            IFS=$animex_subtitle_ifs
        else
            emit_annotated_link_entry "${animex_quality} >${animex_url}" "AnimeX ${animex_provider}" "AnimeX"
        fi
        [ -n "$animex_referrer" ] && printf 'referrer >%s>%s\n' "$animex_url" "$animex_referrer"
        [ -n "$animex_origin" ] && printf 'headers >%s>Origin:%s\n' "$animex_url" "$animex_origin"
    done
    IFS=$old_ifs
}

animex_proxy_url() {
    animex_proxy_payload="$({ printf '%s\0%s' "$1" "$2"; } | od -An -tu1 -v |
        tr -s '[:space:]' '\n' | sed '/^$/d' |
        {
            proxy_key_index=1
            proxy_key_length=${#animex_proxy_key}
            while IFS= read -r proxy_byte; do
                proxy_key_char="$(printf '%s' "$animex_proxy_key" | cut -c "$proxy_key_index")"
                proxy_key_byte="$(printf '%d' "'$proxy_key_char")"
                proxy_encoded_byte=$((proxy_byte ^ proxy_key_byte))
                proxy_encoded_octal="$(printf '%03o' "$proxy_encoded_byte")"
                printf "\\${proxy_encoded_octal}"
                proxy_key_index=$((proxy_key_index % proxy_key_length + 1))
            done
        } | base64 | tr -d '\n' | tr '+/' '-_' | sed 's|=*$||')"
    [ -n "$animex_proxy_payload" ] && printf '%s/uwu/%s\n' "$animex_proxy_base" "$animex_proxy_payload"
}

resolve_animex_episode() {
    animex_slug="$(animex_slug_from_ref "$id")"
    [ -z "$animex_slug" ] && animex_slug="$(select_animex_ref "$1")"
    [ -n "$animex_slug" ] || return 1
    for animex_provider in beep uwu kiwi; do
        resolve_animex_provider "$animex_slug" "$animex_provider"
    done
}

pick_animeflv_language() {
    case "$mode" in
        dub)
            for lang in LAT ESP SUB; do
                printf '%s' "$1" | grep -q "\"$lang\":\\[" && printf '%s\n' "$lang" && return 0
            done
            ;;
        *)
            for lang in SUB ESP LAT; do
                printf '%s' "$1" | grep -q "\"$lang\":\\[" && printf '%s\n' "$lang" && return 0
            done
            ;;
    esac
    return 1
}

extract_animeflv_links() {
    lang_entries="$(printf '%s' "$1" | tr -d '\n' | sed "s|.*\"$2\":\\[||" | sed 's|],"[A-Z][A-Z][A-Z]":.*||; s|]}$||; s|},{|}\
{|g')"
    disabled_mirrors="$(disabled_source_mirrors_for_source "animeflv")"
    failed_mirrors=""
    ok_mirrors=""
    primary_links=""
    fallback_links=""
    old_ifs=$IFS
    IFS='
'
    for entry in $lang_entries; do
        [ -z "$entry" ] && continue
        server="$(printf '%s' "$entry" | sed -nE 's|.*"server":"([^"]*)".*|\1|p')"
        code="$(printf '%s' "$entry" | sed -nE 's|.*"code":"([^"]*)".*|\1|p' | sed 's|\\\/|/|g;s|\\"|"|g')"
        [ -z "$code" ] && continue

        server_name="$(source_label "$server")"
        server_key="$(normalize_mirror_name "$server_name")"
        if source_mirror_is_disabled_in_list "animeflv" "$server_name" "$disabled_mirrors"; then
            source_status "AnimeFLV ${server_name}" "disabled"
            continue
        fi

        direct_link=""
        case "$server" in
            mega)
                [ -n "$server_key" ] && ! printf '%s\n' "$failed_mirrors" | grep -Fxq "$server_key" &&
                    failed_mirrors="${failed_mirrors}${failed_mirrors:+
}${server_key}"
                source_status "AnimeFLV ${server_name}" "skip"
                ;;
            netu)
                [ -n "$server_key" ] && ! printf '%s\n' "$failed_mirrors" | grep -Fxq "$server_key" &&
                    failed_mirrors="${failed_mirrors}${failed_mirrors:+
}${server_key}"
                source_status "AnimeFLV ${server_name}" "skip"
                ;;
            stape)
                direct_link="$(extract_streamtape_link "$code")"
                if [ -n "$direct_link" ] && probe_stream_link "$code" "$direct_link"; then
                    primary_links="${primary_links}880 >${direct_link}
source >${direct_link}>${server_name}
site >${direct_link}>AnimeFLV
"
                    [ -n "$server_key" ] && ! printf '%s\n' "$ok_mirrors" | grep -Fxq "$server_key" &&
                        ok_mirrors="${ok_mirrors}${ok_mirrors:+
}${server_key}"
                    source_status "AnimeFLV ${server_name}" "ok"
                else
                    [ -n "$server_key" ] && ! printf '%s\n' "$failed_mirrors" | grep -Fxq "$server_key" &&
                        failed_mirrors="${failed_mirrors}${failed_mirrors:+
}${server_key}"
                    source_status "AnimeFLV ${server_name}" "skip"
                fi
                ;;
            yu)
                direct_link="$(extract_yourupload_link "$code")"
                if [ -n "$direct_link" ] && probe_link_with_mpv "$direct_link" "$code"; then
                    primary_links="${primary_links}910 >${direct_link}
referrer >${direct_link}>${code}
source >${direct_link}>${server_name}
site >${direct_link}>AnimeFLV
"
                    [ -n "$server_key" ] && ! printf '%s\n' "$ok_mirrors" | grep -Fxq "$server_key" &&
                        ok_mirrors="${ok_mirrors}${ok_mirrors:+
}${server_key}"
                    source_status "AnimeFLV ${server_name}" "ok"
                else
                    [ -n "$server_key" ] && ! printf '%s\n' "$failed_mirrors" | grep -Fxq "$server_key" &&
                        failed_mirrors="${failed_mirrors}${failed_mirrors:+
}${server_key}"
                    source_status "AnimeFLV ${server_name}" "skip"
                fi
                ;;
            *)
                direct_link="$(extract_with_ytdlp "$code")"
                if [ -n "$direct_link" ]; then
                    case "$server" in
                        sw) priority="880" ;;
                        mega) priority="860" ;;
                        *) priority="480" ;;
                    esac
                    primary_links="${primary_links}${priority} >${direct_link}
source >${direct_link}>${server_name}
site >${direct_link}>AnimeFLV
"
                    [ -n "$server_key" ] && ! printf '%s\n' "$ok_mirrors" | grep -Fxq "$server_key" &&
                        ok_mirrors="${ok_mirrors}${ok_mirrors:+
}${server_key}"
                    source_status "AnimeFLV ${server_name}" "ok"
                else
                    [ -n "$server_key" ] && ! printf '%s\n' "$failed_mirrors" | grep -Fxq "$server_key" &&
                        failed_mirrors="${failed_mirrors}${failed_mirrors:+
}${server_key}"
                    source_status "AnimeFLV ${server_name}" "skip"
                fi
                ;;
        esac
    done
    IFS=$old_ifs

    old_ifs=$IFS
    IFS='
'
    for mirror_key in $failed_mirrors; do
        printf '%s\n' "$ok_mirrors" | grep -Fxq "$mirror_key" && continue
        disable_source_mirror "animeflv" "$mirror_key"
    done
    IFS=$old_ifs

    if [ -n "$primary_links" ]; then
        printf '%s' "$primary_links"
    else
        printf '%s' "$fallback_links"
    fi
}

extract_animeflv_wp_links() {
    episode_page="$1"
    player_urls="$(printf '%s' "$episode_page" |
        grep -oE 'data-src="[[:alnum:]+/=]+"' | cut -d'"' -f2)"
    primary_links=""
    old_ifs=$IFS
    IFS='
'
    for encoded_url in $player_urls; do
        remote_url="$(printf '%s' "$encoded_url" | base64 -d 2>/dev/null)"
        [ -n "$remote_url" ] || continue
        direct_link=""
        case "$remote_url" in
            *player.zilla-networks.com/play/*)
                server_name="HLS"
                direct_link="$(extract_animeav1_hls_link "$remote_url")"
                [ -n "$direct_link" ] && probe_link_with_mpv "$direct_link" "$remote_url" "$zilla_header_fields" || direct_link=""
                ;;
            *mp4upload*)
                server_name="MP4Upload"
                direct_link="$(extract_with_ytdlp "$remote_url")"
                ;;
            *uns.bio* | *upnshare*)
                server_name="UPNShare"
                direct_link="$(extract_with_ytdlp "$remote_url")"
                ;;
            *)
                server_name="Mirror"
                direct_link="$(extract_with_ytdlp "$remote_url")"
                ;;
        esac

        if [ -n "$direct_link" ]; then
            primary_links="${primary_links}$(animeav1_server_priority "$server_name") >${direct_link}
referrer >${direct_link}>${remote_url}
source >${direct_link}>${server_name}
site >${direct_link}>AnimeFLV
"
            source_status "AnimeFLV ${server_name}" "ok"
            if fast_first_link_mode; then
                IFS=$old_ifs
                printf '%s' "$primary_links"
                return 0
            fi
        else
            source_status "AnimeFLV ${server_name}" "skip"
        fi
    done
    IFS=$old_ifs
    [ -n "$primary_links" ] && printf '%s' "$primary_links"
}

resolve_spanish_source_links() {
    case "$1" in
        animeflv)
            animeflv_id="$(show_ref_value_for_site "$id" "animeflv")"
            [ -z "$animeflv_id" ] && animeflv_id="$(select_animeflv_id "$title")"
            if [ -n "$animeflv_id" ]; then
                anime_page="$(animeflv_request "${animeflv_refr}/anime/${animeflv_id}/")" || anime_page=""
                episode_path="$(printf '%s' "$anime_page" | sed 's|},{|}\
{|g' | grep -F '"number":'"${ep_no}" | sed -nE 's|.*"permalink":"([^"]+)".*|\1|p' | head -n1 | sed 's|\\/|/|g')"
                [ -n "$episode_path" ] && episode_page="$(animeflv_request "$episode_path")" || episode_page=""
            else
                episode_page=""
            fi

            if [ -n "$episode_page" ]; then
                [ "$mode" = "dub" ] && printf "No hay doblaje disponible en AnimeFLV, usando subtitulado\n" 1>&2
                extract_animeflv_wp_links "$episode_page" | sort -g -r -s
            elif [ -n "$animeflv_id" ]; then
                printf "AnimeFLV no respondio.\n" 1>&2
                return 1
            else
                return 1
            fi
            ;;
        jkanime)
            resolve_jkanime_episode "$title" "$ep_no" | sort -g -r -s
            ;;
        animeav1)
            resolve_animeav1_episode "$title" "$ep_no" | sort -g -r -s
            ;;
        *)
            return 1
            ;;
    esac
}

store_spanish_links_for_source() {
    site_name="$1"
    site_links="$(resolve_spanish_source_links "$site_name")"
    if [ "$fast_mode" = "1" ] && [ "$quality" = "best" ]; then
        site_links="$(filter_playable_links "$site_links" "first")"
    else
        site_links="$(filter_playable_links "$site_links")"
    fi
    site_links="$(filter_links_by_episode_catalog "$site_name" "$site_links" "$authoritative_site" "$authoritative_ep_list")"

    case "$site_name" in
        animeflv) animeflv_links="$site_links" ;;
        jkanime) jkanime_links="$site_links" ;;
        animeav1) animeav1_links="$site_links" ;;
        *) return 1 ;;
    esac

    [ -n "$site_links" ]
}

select_quality() {
    unset headers_flag subs_flag iina_subs_flag subtitle
    # removing urls which have soft subs to avoid playing on android, iSH and vlc (m3u8 streams don't get correct referrer)
    printf '%s' "$player_function" | cut -f1 -d" " | grep -qE '(android|iSH|vlc)' && links=$(printf '%s' "$links" | sed '/cc>/d;/subtitle >/d;/m3u8_refr >/d')
    printf '%s' "$player_function" | cut -f1 -d" " | grep -qE '(android|iSH)' && links=$(printf '%s' "$links" | sed '/Yt >/d')
    requested_quality="$(printf '%s' "$1" | sed 's|p$||')"
    case "$1" in
        best) result=$(printf "%s" "$links" | grep -E '^[0-9]{3,4} >' | head -n1) ;;
        worst) result=$(printf "%s" "$links" | grep -E '^[0-9]{3,4}' | tail -n1) ;;
        *) result=$(printf "%s" "$links" | grep -E "^[0-9]{3,4} >" | grep -m 1 "^${requested_quality} >") ;;
    esac
    [ -z "$result" ] && printf "La calidad especificada no existe, usando la mejor disponible\n" 1>&2 &&
        result=$(printf "%s" "$links" | grep -E '^[0-9]{3,4} >' | head -n1)

    # add refr,sub flags for m3u8 and refr flag for yt
    episode=$(printf "%s" "$result" | cut -d'>' -f2)
    if printf '%s' "$result" | grep -q "cc>"; then
        subtitle="$(find_link_subtitle "$links" "$episode")"
        subs_flag="$(find_link_subtitles "$links" "$episode" | sed 's|^|--sub-file=|' | tr '\n' ' ')"
        iina_subs_flag="$(find_link_subtitles "$links" "$episode" | sed 's|^|--mpv-sub-file=|' | tr '\n' ' ')"
    fi
    generic_headers="$(find_link_headers "$links" "$episode")"
    case "$episode" in
        https://player.zilla-networks.com/*) headers_flag="--http-header-fields=${zilla_header_fields}" ;;
    esac
    [ -n "$generic_headers" ] && headers_flag="--http-header-fields=$generic_headers"
    selected_quality="$(printf '%s' "$result" | cut -d'>' -f1 | tr -d '[:space:]')"
    generic_refr="$(printf '%s\n' "$links" | awk -F'>' -v ep="$episode" '$1=="referrer " && $2==ep { print $3; exit }')"
    selected_site="$(find_link_site "$links" "$episode")"
    selected_source="$(find_link_source "$links" "$episode")"
    selected_origin="$(describe_link_origin "$selected_site" "$selected_source")"
    [ -n "$generic_refr" ] && refr_flag="--referrer=$generic_refr"

    ! (printf '%s' "$result" | grep -q "cc>") && unset refr_flag
    [ -n "$generic_refr" ] && refr_flag="--referrer=$generic_refr"
    ! (printf '%s' "$result" | grep -q "cc>") && unset subs_flag
    return 0
}

get_episode_url() {
    animeflv_links=""
    jkanime_links=""
    animeav1_links=""
    unset selected_spanish_site selected_site selected_source selected_origin
    authoritative_site="$(site_name_from_ref "$id" 2>/dev/null || true)"
    authoritative_ep_list=""
    [ -n "$authoritative_site" ] && authoritative_ep_list="$(episodes_list_for_source "$authoritative_site" "$id" "$title")"
    [ -z "$authoritative_ep_list" ] && authoritative_ep_list="$ep_list"

    if [ "$authoritative_site" = "anidb" ] && [ -n "$anidb_curl_exe" ]; then
        links="$(resolve_anidb_episode "$title" "$ep_no" | sort -g -r -s)"
        if [ "$fast_mode" = "1" ] && [ "$quality" = "best" ]; then
            links="$(filter_playable_links "$links" "first")"
        else
            links="$(filter_playable_links "$links")"
        fi
        if [ -n "$links" ]; then
            printf "Fuente inglesa elegida: AniDB\n" 1>&2
            select_quality "$quality"
            [ -n "$episode" ] && return 0
        fi
        printf "AniDB no produjo un enlace valido; probando las demas fuentes.\n" 1>&2
    fi

    if [ "$authoritative_site" = "animex" ]; then
        links="$(resolve_animex_episode "$title" "$ep_no" | sort -g -r -s)"
        if [ "$fast_mode" = "1" ] && [ "$quality" = "best" ]; then
            links="$(filter_playable_links "$links" "first")"
        else
            links="$(filter_playable_links "$links")"
        fi
        if [ -n "$links" ]; then
            printf "Fuente inglesa elegida: AnimeX\n" 1>&2
            select_quality "$quality"
            [ -n "$episode" ] && return 0
        fi
        printf "AnimeX no produjo un enlace valido; probando las demas fuentes.\n" 1>&2
    fi

    seed_fast_mode_source

    if [ "$fast_mode" = "1" ] && [ -n "$fast_mode_source" ] && ! source_is_disabled "$fast_mode_source"; then
        if ! store_spanish_links_for_source "$fast_mode_source"; then
            disable_spanish_source "$fast_mode_source"
        fi
    fi

    for site_name in jkanime animeav1 animeflv; do
        case "$site_name" in
            animeflv) [ -n "$animeflv_links" ] && continue ;;
            jkanime) [ -n "$jkanime_links" ] && continue ;;
            animeav1) [ -n "$animeav1_links" ] && continue ;;
        esac
        [ "$fast_mode" = "1" ] && [ -n "$fast_mode_source" ] && continue
        if store_spanish_links_for_source "$site_name"; then
            [ "$fast_mode" = "1" ] && break
        fi
    done

    if pick_spanish_source_links "$animeflv_links" "$jkanime_links" "$animeav1_links"; then
        [ -n "$selected_spanish_site" ] && printf "Fuente elegida: %s\n" "$selected_spanish_site" 1>&2
    else
        printf "Las fuentes en espanol no funcionaron. Probando fuente en ingles...\n" 1>&2
        links=""
        if [ -n "$anidb_curl_exe" ]; then
            links="$(resolve_anidb_episode "$title" "$ep_no" | sort -g -r -s)"
            if [ "$fast_mode" = "1" ] && [ "$quality" = "best" ]; then
                links="$(filter_playable_links "$links" "first")"
            else
                links="$(filter_playable_links "$links")"
            fi
            [ -n "$links" ] && printf "Fuente inglesa elegida: AniDB\n" 1>&2
        fi
        if [ -z "$links" ]; then
            links="$(resolve_animex_episode "$title" "$ep_no" | sort -g -r -s)"
            if [ "$fast_mode" = "1" ] && [ "$quality" = "best" ]; then
                links="$(filter_playable_links "$links" "first")"
            else
                links="$(filter_playable_links "$links")"
            fi
            [ -n "$links" ] && printf "Fuente inglesa elegida: AnimeX\n" 1>&2
        fi
    fi
    select_quality "$quality"
    if printf "%s" "$ep_list" | grep -q "^$ep_no$"; then
        [ -z "$episode" ] && die "El episodio ya fue publicado, pero no se encontraron fuentes validas"
    else
        [ -z "$episode" ] && die "Episodio no disponible todavia"
    fi
}

