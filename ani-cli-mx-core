}

update_script() {
    if [ "${ANI_CLI_PACKAGE_MANAGER:-}" = "scoop" ]; then
        command -v powershell.exe >/dev/null 2>&1 ||
            die 'No se encontro PowerShell. Actualiza con: scoop update ani-cli-mx'
        MSYS2_ARG_CONV_EXCL='*' powershell.exe -NoProfile -ExecutionPolicy Bypass \
            -Command 'scoop update ani-cli-mx'
        exit $?
    fi
    [ -z "$update_url" ] && die "La auto-actualizacion no esta configurada para este fork. Define ANI_CLI_UPDATE_URL."
    update="$(curl -s -A "$agent" "$update_url")" || die "Error de conexion"
    update="$(printf '%s\n' "$update" | diff -u "$0" -)"
    if [ -z "$update" ]; then
        printf "Script is up to date :)\n"
    else
        if printf '%s\n' "$update" | patch "$0" -; then
            printf "Script has been updated\n"
        else
            die "Can't update for some reason!"
        fi
    fi
    exit 0
}

is_windows() {
    [ "${ANI_CLI_WINDOWS:-0}" = "1" ] && return 0
    case "$(uname -s 2>/dev/null)" in
        MINGW* | MSYS*) return 0 ;;
        *) return 1 ;;
    esac
}

windows_path_to_posix() {
    if command -v cygpath >/dev/null 2>&1; then
        cygpath -u "$1"
    else
        printf '%s\n' "$1"
    fi
}

posix_path_to_windows() {
    if command -v cygpath >/dev/null 2>&1; then
        cygpath -m "$1"
    elif command -v wslpath >/dev/null 2>&1; then
        wslpath -m "$1"
    else
        printf '%s\n' "$1"
    fi
}

default_hist_dir() {
    if is_windows && [ -n "${LOCALAPPDATA:-}" ]; then
        windows_path_to_posix "$LOCALAPPDATA/$hist_state_name"
    else
        printf '%s\n' "${XDG_STATE_HOME:-$HOME/.local/state}/$hist_state_name"
    fi
}

default_download_dir() {
    if is_windows && [ -n "${USERPROFILE:-}" ]; then
        windows_path_to_posix "$USERPROFILE/Downloads"
        return
    fi
    case "$(uname -a | cut -d " " -f 1,3-)" in
        *ndroid*) printf '%s\n' "${EXTERNAL_STORAGE:-/sdcard}/Download" ;;
        *)
            if command -v xdg-user-dir >/dev/null 2>&1; then
                xdg_download_dir="$(xdg-user-dir DOWNLOAD 2>/dev/null || true)"
            fi
            printf '%s\n' "${xdg_download_dir:-$HOME/Downloads}"
            ;;
    esac
}

# checks if dependencies are present
dep_ch() {
    for dep; do
        command -v "${dep%% *}" >/dev/null || die "No se encontro el programa \"${dep%% *}\". Instalalo e intenta de nuevo."
    done
}

install_download_dependencies() {
    missing_download_deps=""
    command -v aria2c >/dev/null 2>&1 || missing_download_deps="aria2"
    command -v yt-dlp >/dev/null 2>&1 ||
        missing_download_deps="${missing_download_deps:+$missing_download_deps }yt-dlp"
    [ -z "$missing_download_deps" ] && return 0

    printf 'Faltan dependencias de descarga: %s. Intentando instalarlas...\n' "$missing_download_deps" 1>&2
    if is_windows && command -v scoop >/dev/null 2>&1; then
        scoop install aria2 ffmpeg yt-dlp
    elif command -v pkg >/dev/null 2>&1; then
        pkg install -y aria2 ffmpeg yt-dlp
    elif command -v brew >/dev/null 2>&1; then
        brew install aria2 ffmpeg yt-dlp
    elif command -v apt-get >/dev/null 2>&1; then
        run_as_root apt-get update && run_as_root apt-get install -y aria2 ffmpeg yt-dlp
    elif command -v dnf >/dev/null 2>&1; then
        run_as_root dnf install -y aria2 ffmpeg yt-dlp
    elif command -v pacman >/dev/null 2>&1; then
        run_as_root pacman -S --needed aria2 ffmpeg yt-dlp
    elif command -v apk >/dev/null 2>&1; then
        run_as_root apk add aria2 ffmpeg yt-dlp
    else
        die 'No se encontro un gestor compatible. Instala aria2, yt-dlp y ffmpeg.'
    fi

    command -v aria2c >/dev/null 2>&1 || die 'No se pudo instalar aria2.'
    command -v yt-dlp >/dev/null 2>&1 || die 'No se pudo instalar yt-dlp.'
}

run_as_root() {
    if [ "$(id -u)" -eq 0 ]; then
        "$@"
    elif command -v sudo >/dev/null 2>&1; then
        sudo "$@"
    else
        die 'Se necesitan permisos de administrador y no se encontro sudo.'
    fi
}

prepare_download() {
    install_download_dependencies
    mkdir -p "$download_dir" || die "No se pudo crear la carpeta de descargas: $download_dir"
}

where_iina() {
    [ -e "/Applications/IINA.app/Contents/MacOS/iina-cli" ] && echo "/Applications/IINA.app/Contents/MacOS/iina-cli" && return 0
    printf "%s" "iina" && return 0
}

where_mpv() {
    command -v "flatpak" >/dev/null && flatpak info io.mpv.Mpv >/dev/null 2>&1 && printf "%s" "flatpak_mpv" && return 0
    printf "%s" "mpv" && return 0
}

where_wsl_player() {
    windows_player="$1"
    linux_player="$2"

    if command -v "$windows_player" >/dev/null 2>&1 && "$windows_player" --version >/dev/null 2>&1; then
        printf '%s' "$windows_player"
    else
        printf '%s' "$linux_player"
    fi
}

open_browser_url() {
    if is_windows; then
        command -v cmd.exe >/dev/null 2>&1 || return 1
        MSYS2_ARG_CONV_EXCL='*' cmd.exe /d /c start "" "$1" >/dev/null 2>&1
        return $?
    fi
    case "$(uname -a | cut -d " " -f 1,3-)" in
        *Darwin*) command -v open >/dev/null 2>&1 && nohup open "$1" >/dev/null 2>&1 & return 0 ;;
        *ndroid*) command -v termux-open-url >/dev/null 2>&1 && nohup termux-open-url "$1" >/dev/null 2>&1 & return 0 ;;
        *) command -v xdg-open >/dev/null 2>&1 && nohup xdg-open "$1" >/dev/null 2>&1 & return 0 ;;
    esac
    return 1
}

# SCRAPING

animeflv_request() {
    curl -L --connect-timeout 10 --max-time "$resolver_timeout" -e "$animeflv_refr" -s "$1" -A "$agent"
}

jkanime_request() {
    curl -L --connect-timeout 10 --max-time "$resolver_timeout" -s "$1" -A "$agent"
}

animeav1_request() {
    curl -L --connect-timeout 10 --max-time "$resolver_timeout" -s "$1" -A "$agent"
}

probe_search_endpoint() {
    probe_name="$1"
    probe_url="$2"
    probe_output="$(curl -L --connect-timeout 10 --max-time "$resolver_timeout" \
        -sS -o /dev/null -w '%{http_code}' "$probe_url" -A "$agent" 2>&1)"
    probe_exit=$?

    if [ "$probe_exit" -ne 0 ]; then
        printf 'No se pudo consultar %s: %s\n' "$probe_name" "$probe_output" 1>&2
        return 1
    fi

    case "$probe_output" in
        2?? | 3??) return 0 ;;
        *)
            printf 'No se pudo consultar %s: HTTP %s\n' "$probe_name" "$probe_output" 1>&2
            return 1
            ;;
    esac
}

diagnose_empty_search() {
    diagnostic_query="$1"
    diagnostic_failed=0
    probe_search_endpoint "AnimeAV1" "${animeav1_refr}/catalogo?search=${diagnostic_query}" || diagnostic_failed=1
    probe_search_endpoint "JKAnime" "${jkanime_refr}/buscar?q=${diagnostic_query}" || diagnostic_failed=1
    probe_search_endpoint "AnimeFLV" "${animeflv_refr}/wp-json/wp/v2/categories?per_page=1" || diagnostic_failed=1

    if [ "$diagnostic_failed" -eq 1 ]; then
        die "No fue posible consultar las fuentes. Revisa DNS, firewall, proxy, antivirus o certificados TLS"
    fi

    die "No se encontraron resultados"
}

extract_with_ytdlp() {
    command -v "yt-dlp" >/dev/null 2>&1 || return 1

    candidate_urls="$(timeout "${resolver_timeout}s" yt-dlp --socket-timeout "$resolver_timeout" \
        --format "b/best" --get-url --no-playlist "$1" 2>/dev/null)"
    candidate_url="$(select_ytdlp_url "$candidate_urls")"
    [ -n "$candidate_url" ] && printf '%s\n' "$candidate_url" && return 0

    candidate_urls="$(timeout "${resolver_timeout}s" yt-dlp --socket-timeout "$resolver_timeout" \
        --get-url --no-playlist "$1" 2>/dev/null)"
    select_ytdlp_url "$candidate_urls"
}

normalize_romanized_text() {
    printf '%s' "$1" | sed '
        s/[Āā]/aa/g
        s/[Ēē]/ei/g
        s/[Īī]/ii/g
        s/[Ōō]/ou/g
        s/[Ūū]/uu/g
        s/[ÂÀÁÄÃÅâàáäãå]/a/g
        s/[ÊÈÉËêèéë]/e/g
        s/[ÎÌÍÏîìíï]/i/g
        s/[ÔÒÓÖÕôòóöõ]/o/g
        s/[ÛÙÚÜûùúü]/u/g
        s/[Çç]/c/g
        s/[Ññ]/n/g
    '
}

normalize_romanized_text_plain() {
    printf '%s' "$1" | sed '
        s/[ĀāÂÀÁÄÃÅâàáäãå]/a/g
        s/[ĒēÊÈÉËêèéë]/e/g
        s/[ĪīÎÌÍÏîìíï]/i/g
        s/[ŌōÔÒÓÖÕôòóöõ]/o/g
        s/[ŪūÛÙÚÜûùúü]/u/g
        s/[Çç]/c/g
        s/[Ññ]/n/g
    '
}

compact_search_query() {
    sed 's|[[:space:]]\+|+|g; s|^+||; s|+$||'
}

search_query_from_text() {
    normalize_romanized_text "$(printf '%s' "$1" | sed 's|+| |g')" |
        compact_search_query
}

search_query_candidates_from_text() {
    query_text="$(printf '%s' "$1" | sed 's|+| |g')"
    {
        normalize_romanized_text "$query_text" | compact_search_query
        printf '\n'
        normalize_romanized_text_plain "$query_text" | compact_search_query
        printf '\n'
    } | sed '/^$/d' | awk '!seen[$0]++'
}

normalize_match_key() {
    normalize_romanized_text "$1" | tr '[:upper:]' '[:lower:]' | tr -cd '[:alnum:]'
}

normalize_match_words() {
    normalize_romanized_text "$1" | tr '[:upper:]' '[:lower:]' |
        sed 's/[^[:alnum:]]\+/ /g; s/^ *//; s/ *$//; s/[[:space:]][[:space:]]*/ /g'
}

extract_season_hint() {
    normalized_words=" $(normalize_match_words "$1") "
    season_hint="$(printf '%s\n' "$normalized_words" | sed -nE '
        s|.* season ([0-9]+) .*|\1|p
        s|.* ([0-9]+)(st|nd|rd|th) season .*|\1|p
        s|.* temporada ([0-9]+) .*|\1|p
        s|.* ([0-9]+)(a|da|ra) temporada .*|\1|p
        s|.* part ([0-9]+) .*|\1|p
        s|.* cour ([0-9]+) .*|\1|p
        s|.* stage ([0-9]+) .*|\1|p
        s|.* s([0-9]+) .*|\1|p
    ' | head -n1)"
    [ -n "$season_hint" ] && printf '%s\n' "$season_hint" && return 0

    case "$normalized_words" in
        *" first season "* | *" primera temporada "* | *" ichi gakki "*) printf '1\n' ;;
        *" second season "* | *" segunda temporada "* | *" 2nd season "* | *" 2da temporada "* | *" 2a temporada "* | *" ni gakki "*) printf '2\n' ;;
        *" third season "* | *" tercera temporada "* | *" 3rd season "* | *" 3ra temporada "* | *" 3a temporada "* | *" san gakki "*) printf '3\n' ;;
        *" fourth season "* | *" cuarta temporada "* | *" 4th season "* | *" 4ta temporada "* | *" 4a temporada "* | *" yon gakki "*) printf '4\n' ;;
        *" fifth season "* | *" quinta temporada "* | *" 5th season "* | *" 5ta temporada "* | *" 5a temporada "* | *" go gakki "*) printf '5\n' ;;
        *) return 1 ;;
    esac
}

extract_slug_season_hint() {
    raw_slug="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
    printf '%s\n' "$raw_slug" | sed -nE '
        s#.*[-_/]s([0-9]+)$#\1#p
        s#.*[-_/](1st|2nd|3rd|4th|5th)[-_/]season$#\1#p
        s#.*[-_/]season[-_/]?([0-9]+)$#\1#p
        s#.*[-_/]part[-_/]?([0-9]+)$#\1#p
        s#.*[-_/]([1-9])$#\1#p
    ' | sed '
        s/^1st$/1/
        s/^2nd$/2/
        s/^3rd$/3/
        s/^4th$/4/
        s/^5th$/5/
    ' | head -n1
}

match_token_overlap_score() {
    query_words="$(normalize_match_words "$1")"
    candidate_words=" $(normalize_match_words "$2") "
    overlap_score=0
    for word in $query_words; do
        [ "${#word}" -lt 3 ] && continue
        case "$candidate_words" in
            *" $word "*) overlap_score=$((overlap_score + 35)) ;;
        esac
    done
    printf '%s\n' "$overlap_score"
}

match_word_is_generic() {
    case "$1" in
        a | an | and | the | of | no | ni | to | de | del | la | las | el | los | y | en | un | una) return 0 ;;
        season | temporada | movie | pelicula | film | ova | special | specials | episode | episodio) return 0 ;;
        part | cour | stage | first | second | third | fourth | fifth | primera | segunda | tercera | cuarta | quinta) return 0 ;;
        school | gakki | sub | dub) return 0 ;;
        1st | 2nd | 3rd | 4th | 5th | 1ra | 2da | 3ra | 4ta | 5ta | 1a | 2a | 3a | 4a | 5a) return 0 ;;
        *) return 1 ;;
    esac
}

count_distinctive_query_words() {
    query_words="$(normalize_match_words "$1")"
    distinctive_count=0
    for word in $query_words; do
        [ "${#word}" -lt 3 ] && continue
        match_word_is_generic "$word" && continue
        distinctive_count=$((distinctive_count + 1))
    done
    printf '%s\n' "$distinctive_count"
}

count_distinctive_overlap() {
    query_words="$(normalize_match_words "$1")"
    candidate_words=" $(normalize_match_words "$2") "
    distinctive_overlap=0
    for word in $query_words; do
        [ "${#word}" -lt 3 ] && continue
        match_word_is_generic "$word" && continue
        case "$candidate_words" in
            *" $word "*) distinctive_overlap=$((distinctive_overlap + 1)) ;;
        esac
    done
    printf '%s\n' "$distinctive_overlap"
}

title_match_score() {
    query_title="$1"
    candidate_id="$2"
    candidate_title="$3"
    query_key="$(normalize_match_key "$query_title")"
    candidate_key="$(normalize_match_key "$candidate_title")"
    query_context="$(normalize_match_words "$query_title $(printf '%s' "$id" | tr ':|_-' '     ')")"
    candidate_context="$(normalize_match_words "$candidate_title $(printf '%s' "$candidate_id" | tr ':|_-' '     ')")"
    score=0

    [ "$candidate_key" = "$query_key" ] && score=$((score + 1000))
    case "$candidate_key" in
        *"$query_key"*) score=$((score + 400)) ;;
    esac
    case "$query_key" in
        *"$candidate_key"*) score=$((score + 200)) ;;
    esac

    score=$((score + $(match_token_overlap_score "$query_context" "$candidate_context")))
    distinctive_query_count="$(count_distinctive_query_words "$query_context")"
    distinctive_overlap_count="$(count_distinctive_overlap "$query_context" "$candidate_context")"
    if [ "$distinctive_query_count" -gt 0 ]; then
        if [ "$distinctive_overlap_count" -gt 0 ]; then
            score=$((score + (distinctive_overlap_count * 120)))
        else
            score=$((score - 1500))
        fi
    fi

    query_season="$(extract_season_hint "$query_context" 2>/dev/null || true)"
    [ -z "$query_season" ] && query_season="$(extract_slug_season_hint "${id#*:}" 2>/dev/null || true)"
    candidate_season="$(extract_season_hint "$candidate_context" 2>/dev/null || true)"
    [ -z "$candidate_season" ] && candidate_season="$(extract_slug_season_hint "$candidate_id" 2>/dev/null || true)"
    if [ -n "$query_season" ]; then
        if [ "$candidate_season" = "$query_season" ]; then
            score=$((score + 350))
        elif [ -n "$candidate_season" ]; then
            score=$((score - 900))
        else
            score=$((score - 450))
        fi
    elif [ -n "$candidate_season" ]; then
        if [ "$candidate_season" = "1" ]; then
            score=$((score + 60))
        else
            score=$((score - 260))
        fi
    fi

    printf '%s\n' "$score"
}

cross_source_match_is_confident() {
    [ -n "$1" ] || return 1
    [ "$1" -ge 140 ]
}

site_name_from_ref() {
    case "$1" in
        animeflv:*) printf '%s\n' "animeflv" ;;
        jkanime:*) printf '%s\n' "jkanime" ;;
        animeav1:*) printf '%s\n' "animeav1" ;;
        anidb:*) printf '%s\n' "anidb" ;;
        animex:*) printf '%s\n' "animex" ;;
        *:*) return 1 ;;
        "") return 1 ;;
        *) return 1 ;;
    esac
}

show_ref_value_for_site() {
    case "$1" in
        "$2":*) printf '%s\n' "${1#"$2:"}" ;;
        *)
            [ "$2" = "animeflv" ] && case "$1" in
                *:*) return 1 ;;
                *) printf '%s\n' "$1" ;;
            esac
            ;;
    esac
}

prefix_search_results() {
    site_name="$1"
    old_ifs=$IFS
    IFS='
'
    for entry in $2; do
        result_id="$(printf '%s' "$entry" | cut -f1)"
        result_title="$(printf '%s' "$entry" | cut -f2)"
        [ -z "$result_id" ] && continue
        [ -z "$result_title" ] && continue
        printf '%s:%s\t%s\t%s [%s]\n' "$site_name" "$result_id" "$result_title" "$result_title" "$(info_source_label "$site_name")"
    done
    IFS=$old_ifs
}

build_anime_menu() {
    menu_index=0
    while IFS='	' read -r menu_id menu_title menu_label; do
        [ -n "$menu_id" ] || continue
        menu_index=$((menu_index + 1))
        [ -n "$menu_label" ] || menu_label="$menu_title"
        case "$menu_id" in
            anidb:* | animex:*) menu_language="[ENGLISH]" ;;
            *) menu_language="[ESPAÑOL]" ;;
        esac
        printf '%d\t%s\t%s %s\n' "$menu_index" "$menu_id" "$menu_language" "$menu_label"
    done
}

normalize_info_source() {
    case "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" in
        "" | auto) printf '%s\n' "auto" ;;
        animeflv | flv) printf '%s\n' "animeflv" ;;
        jkanime | jk) printf '%s\n' "jkanime" ;;
        animeav1 | av1) printf '%s\n' "animeav1" ;;
        anidb | ani-db | english) printf '%s\n' "anidb" ;;
        animex | anime-x) printf '%s\n' "animex" ;;
        *) return 1 ;;
    esac
}

info_source_label() {
    case "$1" in
        auto) printf '%s\n' "Auto" ;;
        animeflv) printf '%s\n' "AnimeFLV" ;;
        jkanime) printf '%s\n' "JKAnime" ;;
        animeav1) printf '%s\n' "AnimeAV1" ;;
        anidb) printf '%s\n' "AniDB" ;;
        animex) printf '%s\n' "AnimeX" ;;
        *) printf '%s\n' "$1" ;;
    esac
}

source_key_from_label() {
    case "$1" in
        AnimeFLV | AnimeFLV\ *) printf '%s\n' "animeflv" ;;
        JKAnime | JKAnime\ *) printf '%s\n' "jkanime" ;;
        AnimeAV1 | AnimeAV1\ *) printf '%s\n' "animeav1" ;;
        *) return 1 ;;
    esac
}

is_spanish_source() {
    case "$1" in
        animeflv | jkanime | animeav1) return 0 ;;
        *) return 1 ;;
    esac
}

seed_fast_mode_source() {
    [ "$fast_mode" = "1" ] || return 0
    [ -n "$fast_mode_source" ] && return 0

    selected_fast_source="$(site_name_from_ref "$id" 2>/dev/null || true)"
    if ! is_spanish_source "$selected_fast_source" && is_spanish_source "$preferred_info_source"; then
        selected_fast_source="$preferred_info_source"
    fi
    is_spanish_source "$selected_fast_source" || return 0

    fast_mode_source="$selected_fast_source"
    preferred_spanish_site="$(info_source_label "$fast_mode_source")"
    fast_mode_ep_list="$(episodes_list_for_source "$fast_mode_source" "$id" "$title")"
    [ -n "$fast_mode_ep_list" ] && ep_list="$fast_mode_ep_list"
}

source_is_disabled() {
    case " $disabled_spanish_sources " in
        *" $1 "*) return 0 ;;
        *) return 1 ;;
    esac
}

disable_spanish_source() {
    [ -n "$1" ] || return 0
    source_is_disabled "$1" && return 0
    disabled_spanish_sources="${disabled_spanish_sources}${disabled_spanish_sources:+ }$1"
    if [ "$fast_mode_source" = "$1" ]; then
        fast_mode_source=""
        fast_mode_ep_list=""
        ep_list="$(episodes_list "$id" "$title")"
    fi
    printf "Fast mode: desactivando %s para esta sesion.\n" "$(info_source_label "$1")" 1>&2
}

normalize_mirror_name() {
    printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed 's|[[:space:]]\+|_|g'
}

source_mirror_is_disabled_in_list() {
    mirror_key="$(normalize_mirror_name "$2")"
    printf '%s\n' "$3" | grep -Fxq "$1>${mirror_key}"
}

disabled_source_mirrors_for_source() {
    [ -n "$fast_mode_mirror_file" ] && [ -f "$fast_mode_mirror_file" ] || return 0
    grep -E "^$1>" "$fast_mode_mirror_file" 2>/dev/null || true
}

disable_source_mirror() {
    [ "$fast_mode" = "1" ] || return 0
    [ "$fast_mode_source" = "$1" ] || return 0
    [ -n "$2" ] || return 0
    mirror_key="$(normalize_mirror_name "$2")"
    [ -n "$mirror_key" ] || return 0
    [ -n "$fast_mode_mirror_file" ] || return 0
    mirror_entry="$1>${mirror_key}"
    [ -f "$fast_mode_mirror_file" ] && grep -Fxq "$mirror_entry" "$fast_mode_mirror_file" && return 0
    printf '%s\n' "$mirror_entry" >>"$fast_mode_mirror_file"
}

source_label() {
    case "$1" in
        sw) printf '%s' "StreamWish" ;;
        stape) printf '%s' "Streamtape" ;;
        netu) printf '%s' "HQQ" ;;
        mega) printf '%s' "Mega" ;;
        yu) printf '%s' "YourUpload" ;;
        okru) printf '%s' "Okru" ;;
        fembed) printf '%s' "Fembed" ;;
        *) printf '%s' "$1" ;;
    esac
}

source_status() {
    case "$2" in
        ok) printf "\033[1;32m%s\033[0m Links Fetched\n" "$1" 1>&2 ;;
        fallback) printf "\033[1;33m%s\033[0m Fallback Only\n" "$1" 1>&2 ;;
        skip) printf "\033[1;31m%s\033[0m No Valid Link\n" "$1" 1>&2 ;;
        disabled) : ;;
    esac
}

fast_first_link_mode() {
    [ "$fast_mode" = "1" ] && [ "$quality" = "best" ]
}

probe_stream_link() {
    headers="$(curl -I -L --connect-timeout 10 --max-time "$resolver_timeout" -s -e "$1" "$2" -A "$agent")" || return 1
    printf '%s' "$headers" | grep -qiE '^content-type: (video/|application/vnd\.apple\.mpegurl|application/x-mpegurl)'
}

find_link_referrer() {
    printf '%s\n' "$1" | awk -F'>' -v ep="$2" '$1=="referrer " && $2==ep { print $3; exit }'
}

find_link_source() {
    printf '%s\n' "$1" | awk -F'>' -v ep="$2" '$1=="source " && $2==ep { print $3; exit }'
}

find_link_site() {
    printf '%s\n' "$1" | awk -F'>' -v ep="$2" '$1=="site " && $2==ep { print $3; exit }'
}

find_link_headers() {
    printf '%s\n' "$1" | while IFS='>' read -r metadata_type metadata_url metadata_value; do
        if [ "$metadata_type" = "headers " ] && [ "$metadata_url" = "$2" ]; then
            printf '%s\n' "$metadata_value"
            break
        fi
    done
}

find_link_subtitles() {
    printf '%s\n' "$1" | while IFS='>' read -r metadata_type metadata_url metadata_value; do
        if [ "$metadata_type" = "subtitle " ] && [ "$metadata_url" = "$2" ]; then
            printf '%s\n' "$metadata_value"
        fi
    done
}

find_link_subtitle() {
    find_link_subtitles "$1" "$2" | head -n1
}

describe_link_origin() {
    if [ -n "$1" ] && [ -n "$2" ]; then
        [ "$1" = "$2" ] && printf '%s' "$1" || printf '%s / %s' "$1" "$2"
        return 0
    fi
    [ -n "$1" ] && printf '%s' "$1" && return 0
    [ -n "$2" ] && printf '%s' "$2" && return 0
    return 1
}

count_quality_links() {
    printf '%s\n' "$1" | grep -cE '^[0-9]{3,4} >'
}

find_link_quality() {
    printf '%s\n' "$1" | awk -F'>' -v ep="$2" '$1 ~ /^[0-9]{3,4} / && $2==ep { sub(/[[:space:]]+$/, "", $1); print $1; exit }'
}

emit_annotated_link_entry() {
    entry_url="$(printf '%s' "$1" | cut -d'>' -f2)"
    [ -z "$entry_url" ] && entry_url="$1"
    printf '%s\n' "$1"
    [ -n "$2" ] && printf 'source >%s>%s\n' "$entry_url" "$2"
    [ -n "$3" ] && printf 'site >%s>%s\n' "$entry_url" "$3"
}

quality_menu_entries() {
    old_ifs=$IFS
    IFS='
'
    menu_index=1
    for entry in $1; do
        printf '%s' "$entry" | grep -qE '^[0-9]{3,4} >' || continue
        candidate_quality="$(printf '%s' "$entry" | cut -d'>' -f1)"
        candidate_url="$(printf '%s' "$entry" | cut -d'>' -f2)"
        candidate_site="$(find_link_site "$1" "$candidate_url")"
        candidate_source="$(find_link_source "$1" "$candidate_url")"
        origin_label="$(describe_link_origin "$candidate_site" "$candidate_source")"
        [ -n "$origin_label" ] && printf '%s\t%s\t%s\n' "$menu_index" "$candidate_quality" "$origin_label" ||
            printf '%s\t%s\t%s\n' "$menu_index" "$candidate_quality" "Desconocida"
        menu_index=$((menu_index + 1))
    done
    IFS=$old_ifs
}

available_site_entries() {
    menu_index=1
    for site_name in JKAnime AnimeAV1 AnimeFLV; do
        case "$site_name" in
            AnimeFLV) site_links="$1" ;;
            JKAnime) site_links="$2" ;;
            AnimeAV1) site_links="$3" ;;
        esac
        site_count="$(count_quality_links "$site_links")"
        [ "$site_count" -gt 0 ] || continue
        printf '%s\t%s\t%s (%s enlaces)\n' "$menu_index" "$site_name" "$site_name" "$site_count"
        menu_index=$((menu_index + 1))
    done
}

set_links_for_site() {
    site_key="$(source_key_from_label "$1" 2>/dev/null || true)"
    case "$1" in
        AnimeFLV) links="$animeflv_links" ;;
        JKAnime) links="$jkanime_links" ;;
        AnimeAV1) links="$animeav1_links" ;;
        *) return 1 ;;
    esac
    selected_spanish_site="$1"
    preferred_spanish_site="$1"
    if [ "$fast_mode" = "1" ]; then
        if source_is_disabled "$site_key"; then
            disable_spanish_source "$site_key"
        else
            fast_mode_source="$site_key"
            fast_mode_ep_list="$(episodes_list_for_source "$fast_mode_source" "$id" "$title")"
            [ -n "$fast_mode_ep_list" ] && ep_list="$fast_mode_ep_list"
        fi
    fi
    return 0
}

pick_spanish_source_links() {
    site_options="$(available_site_entries "$1" "$2" "$3")"
    available_sites="$(printf '%s\n' "$site_options" | sed '/^$/d')"
    [ -z "$available_sites" ] && return 1

    if [ -n "$preferred_spanish_site" ] && printf '%s\n' "$available_sites" | cut -f2 | grep -Fxq "$preferred_spanish_site"; then
        selected_spanish_site="$preferred_spanish_site"
    else
        site_count="$(printf '%s\n' "$available_sites" | wc -l | tr -d '[:space:]')"
        if [ "$site_count" -eq 1 ]; then
            selected_spanish_site="$(printf '%s\n' "$available_sites" | cut -f2)"
        else
            selected_spanish_site="$(printf '%s\n' "$available_sites" | nth "Selecciona fuente: " | cut -f1)"
        fi
    fi

    case "$selected_spanish_site" in
        AnimeFLV) set_links_for_site "AnimeFLV" ;;
        JKAnime) set_links_for_site "JKAnime" ;;
        AnimeAV1) set_links_for_site "AnimeAV1" ;;
        *) return 1 ;;
    esac
    return 0
}

link_is_probably_broken() {
    case "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" in
        *novideo* | *no-video* | *no_video* | *video_not_found* | *404.mp4* | *404.m3u8*) return 0 ;;
        *) return 1 ;;
    esac
}

select_ytdlp_url() {
    old_ifs=$IFS
    IFS='
'
    for candidate_url in $1; do
        [ -z "$candidate_url" ] && continue
        printf '%s' "$candidate_url" | grep -qE '^https?://' || continue
        link_is_probably_broken "$candidate_url" && continue
        printf '%s\n' "$candidate_url"
        IFS=$old_ifs
        return 0
    done
    IFS=$old_ifs
    return 1
}

probe_link_with_mpv() {
    probe_referrer=""
    probe_headers=""
    [ -n "$2" ] && probe_referrer="--referrer=$2"
    [ -n "$3" ] && probe_headers="--http-header-fields=$3"

    # Probe candidates with a silent one-frame decode, so only actually playable
    # sources survive selection.
    case "$player_function" in
        flatpak_mpv)
            timeout "${probe_timeout}s" flatpak run io.mpv.Mpv --no-config --ao=null --vo=null --frames=1 \
                --really-quiet $probe_referrer $probe_headers "$1" >/dev/null 2>&1
            ;;
        mpv.exe | */mpv.exe)
            timeout "${probe_timeout}s" "$player_function" --no-config --ao=null --vo=null --frames=1 \
                --really-quiet $probe_referrer $probe_headers "$1" >/dev/null 2>&1
            ;;
        mpv | */mpv)
            timeout "${probe_timeout}s" "$player_function" --no-config --ao=null --vo=null --frames=1 \
                --really-quiet $probe_referrer $probe_headers "$1" >/dev/null 2>&1
            ;;
        *)
            if command -v mpv >/dev/null 2>&1; then
                timeout "${probe_timeout}s" mpv --no-config --ao=null --vo=null --frames=1 \
                    --really-quiet $probe_referrer $probe_headers "$1" >/dev/null 2>&1
            elif command -v flatpak >/dev/null 2>&1 && flatpak info io.mpv.Mpv >/dev/null 2>&1; then
                timeout "${probe_timeout}s" flatpak run io.mpv.Mpv --no-config --ao=null --vo=null --frames=1 \
                    --really-quiet $probe_referrer $probe_headers "$1" >/dev/null 2>&1
            else
                return 0
            fi
            ;;
    esac
}

filter_playable_links() {
    stop_after_first="${2:-}"
    playable_links=""
    old_ifs=$IFS
    IFS='
'
    for entry in $1; do
        printf '%s' "$entry" | grep -qE '^[0-9]{3,4} >' || continue
        candidate_url="$(printf '%s' "$entry" | cut -d'>' -f2)"
        link_is_probably_broken "$candidate_url" && continue
        candidate_referrer="$(find_link_referrer "$1" "$candidate_url")"
        candidate_headers="$(find_link_headers "$1" "$candidate_url")"
        candidate_subtitles="$(find_link_subtitles "$1" "$candidate_url")"
        # Fast mode has already resolved a concrete stream URL. Starting mpv
        # here would make the user wait for a hidden player before starting the
        # real one, which is especially noticeable for remote HLS playlists.
        if [ "$stop_after_first" = "first" ] || probe_link_with_mpv "$candidate_url" "$candidate_referrer" "$candidate_headers"; then
            playable_links="${playable_links}${entry}
"
            [ -n "$candidate_referrer" ] && playable_links="${playable_links}referrer >${candidate_url}>${candidate_referrer}
"
            [ -n "$candidate_headers" ] && playable_links="${playable_links}headers >${candidate_url}>${candidate_headers}
"
            if [ -n "$candidate_subtitles" ]; then
                candidate_subtitle_ifs=$IFS
                IFS='
'
                for candidate_subtitle in $candidate_subtitles; do
                    playable_links="${playable_links}subtitle >${candidate_url}>${candidate_subtitle}
"
                done
                IFS=$candidate_subtitle_ifs
            fi
            candidate_source="$(find_link_source "$1" "$candidate_url")"
            [ -n "$candidate_source" ] && playable_links="${playable_links}source >${candidate_url}>${candidate_source}
"
            candidate_site="$(find_link_site "$1" "$candidate_url")"
            [ -n "$candidate_site" ] && playable_links="${playable_links}site >${candidate_url}>${candidate_site}
"
            if [ "$stop_after_first" = "first" ]; then
                IFS=$old_ifs
                printf '%s' "$playable_links"
                return 0
            fi
        fi
    done
    IFS=$old_ifs

    [ -n "$playable_links" ] && printf '%s' "$playable_links"
}

extract_streamtape_link() {
    streamtape_page="$(curl -L --connect-timeout 10 --max-time "$resolver_timeout" -s "$1" -A "$agent")" || return 1
    js_expr="$(printf '%s' "$streamtape_page" | tr '\n' ' ' |
        sed -nE "s|.*document.getElementById\\('botlink'\\)\\.innerHTML = ([^;]+);.*|\\1|p" | head -n1)"
    if [ -n "$js_expr" ]; then
        prefix="$(printf '%s' "$js_expr" | sed -nE "s|^[[:space:]]*'([^']*)'.*|\\1|p")"
        suffix="$(printf '%s' "$js_expr" | sed -nE "s|.*\\('([^']*)'\\).*|\\1|p")"
        substring_steps="$(printf '%s' "$js_expr" | grep -oE 'substring\([0-9]+\)' | sed 's/[^0-9]//g')"
        for skip_chars in $substring_steps; do
            skip_chars=$((skip_chars + 1))
            suffix="$(printf '%s' "$suffix" | cut -c"${skip_chars}"-)"
        done
        direct_path="${prefix}${suffix}"
        case "$direct_path" in
            //*) direct_path="https:${direct_path}" ;;
            /*) direct_path="https:/${direct_path}" ;;
        esac
        case "$direct_path" in
            *stream=1*) printf '%s\n' "$direct_path" ;;
            *) printf '%s&stream=1\n' "$direct_path" ;;
        esac
        return 0
    fi

    direct_path="$(printf '%s' "$streamtape_page" | sed -nE 's|.*id="botlink"[^>]*>([^<]+)<.*|\1|p' | tail -n1)"
    [ -z "$direct_path" ] && return 1
    case "$direct_path" in
        //*) direct_path="https:${direct_path}" ;;
        /*) direct_path="https:/${direct_path}" ;;
    esac
    printf '%s&stream=1\n' "$direct_path"
}

extract_hqq_link() {
    hqq_page="$(curl -L --connect-timeout 10 --max-time "$resolver_timeout" -s "$1" -A "$agent")" || return 1
    printf '%s' "$hqq_page" | tr '\n' ' ' |
        sed -nE "s|.*olplayer\\.src\\(\\{[^}]*src: '([^']+)'[^}]*type: 'application/x-mpegURL'.*|\\1|p" | head -n1
}

extract_yourupload_link() {
    direct_link="$(extract_with_ytdlp "$1")"
    [ -n "$direct_link" ] && printf '%s\n' "$direct_link" && return 0

    yourupload_page="$(curl -L --connect-timeout 10 --max-time "$resolver_timeout" -s "$1" -A "$agent")" || return 1
    direct_link="$(printf '%s' "$yourupload_page" | tr '\n' ' ' |
        grep -oE "file:[[:space:]]*'[^']+'" | head -n1 | sed -E "s|file:[[:space:]]*'([^']+)'|\\1|")"
    [ -n "$direct_link" ] && printf '%s\n' "$direct_link" && return 0

    printf '%s' "$yourupload_page" | tr '\n' ' ' |
        grep -oE 'file:[[:space:]]*"[^"]+"' | head -n1 | sed -E 's|file:[[:space:]]*"([^"]+)"|\1|'
}

search_jkanime() {
    jkanime_request "${jkanime_refr}/buscar?q=$1" | tr '\n' ' ' |
        sed 's|<div class="col-lg-2 col-md-6 col-sm-6"|\n&|g' |
        sed -nE 's|.*<a[[:space:]]+href="https://jkanime\.net/([^"/]+)/".*<h5><a[[:space:]]+href="https://jkanime\.net/[^"]+/">([^<]+)</a></h5>.*|\1\t\2|p'
}

search_animeflv() {
    animeflv_query="$(printf '%s' "$1" | tr '+' ' ' | tr '[:upper:]' '[:lower:]')"
    animeflv_catalog=""
    for page_no in 1 2; do
        page_results="$(animeflv_request "${animeflv_refr}/wp-json/wp/v2/categories?per_page=100&page=${page_no}" |
            sed 's|},{"id"|}\
{"id"|g' |
            sed -nE 's|^\{"id":[0-9]+,"count":[0-9]+,[^}]*"name":"([^"]*)","slug":"([^"]+)".*|\2\t\1|p')"
        animeflv_catalog="${animeflv_catalog}${page_results}
"
    done

    printf '%s' "$animeflv_catalog" | awk -F '\t' -v query="$animeflv_query" '
        BEGIN { count = split(query, words, /[[:space:]]+/) }
        $1 != "anime" {
            candidate = tolower($1 " " $2)
            matches = 1
            for (i = 1; i <= count; i++) {
                if (words[i] != "" && index(candidate, words[i]) == 0) matches = 0
            }
            if (matches) print
        }
    '
}

search_animeflv_variants() {
    for candidate_query in $(search_query_candidates_from_text "$1"); do
        search_animeflv "$candidate_query"
    done | awk '!seen[$0]++'
}

search_jkanime_variants() {
    for candidate_query in $(search_query_candidates_from_text "$1"); do
        search_jkanime "$candidate_query"
    done | awk '!seen[$0]++'
}

search_animeav1_variants() {
    for candidate_query in $(search_query_candidates_from_text "$1"); do
        search_animeav1 "$candidate_query"
    done | awk '!seen[$0]++'
}

select_animeflv_id() {
    cache_key="$1|$id"
    [ "$animeflv_selected_id_key" = "$cache_key" ] && [ -n "$animeflv_selected_id" ] && printf '%s\n' "$animeflv_selected_id" && return 0

    animeflv_results="$(search_animeflv_variants "$1")"
    [ -z "$animeflv_results" ] && return 1

    best_id=""
    best_score=-999999
    old_ifs=$IFS
    IFS='
'
    for entry in $animeflv_results; do
        candidate_id="$(printf '%s' "$entry" | cut -f1)"
        candidate_title="$(printf '%s' "$entry" | cut -f2)"
        [ -z "$candidate_id" ] && continue
        score="$(title_match_score "$1" "$candidate_id" "$candidate_title")"
        [ "$score" -gt "$best_score" ] && best_score="$score" && best_id="$candidate_id"
    done
    IFS=$old_ifs

    cross_source_match_is_confident "$best_score" || return 1
    [ -z "$best_id" ] && best_id="$(printf '%s\n' "$animeflv_results" | sed -n '1p' | cut -f1)"
    [ -z "$best_id" ] && return 1

    animeflv_selected_id="$best_id"
    animeflv_selected_id_key="$cache_key"
    printf '%s\n' "$animeflv_selected_id"
}

select_jkanime_slug() {
    explicit_slug="$(show_ref_value_for_site "$id" "jkanime")"
    if [ -n "$explicit_slug" ]; then
        jkanime_slug="$explicit_slug"
        jkanime_slug_key="explicit:$id"
    fi
    [ -n "$explicit_slug" ] && printf '%s\n' "$jkanime_slug" && return 0

    cache_key="$1|$id"
    [ "$jkanime_slug_key" = "$cache_key" ] && [ -n "$jkanime_slug" ] && printf '%s\n' "$jkanime_slug" && return 0

    jkanime_results="$(search_jkanime_variants "$1")"
    [ -z "$jkanime_results" ] && return 1

    best_slug=""
    best_score=-999999
    old_ifs=$IFS
    IFS='
'
    for entry in $jkanime_results; do
        slug="$(printf '%s' "$entry" | cut -f1)"
        name="$(printf '%s' "$entry" | cut -f2)"
        [ -z "$slug" ] && continue
        score="$(title_match_score "$1" "$slug" "$name")"
        [ "$slug" = "$id" ] && score=$((score + 100))
        [ "$score" -gt "$best_score" ] && best_score="$score" && best_slug="$slug"
    done
    IFS=$old_ifs

    cross_source_match_is_confident "$best_score" || return 1
    [ -z "$best_slug" ] && best_slug="$(printf '%s\n' "$jkanime_results" | sed -n '1p' | cut -f1)"
    [ -z "$best_slug" ] && return 1

    jkanime_slug="$best_slug"
    jkanime_slug_key="$cache_key"
    printf '%s\n' "$jkanime_slug"
}

