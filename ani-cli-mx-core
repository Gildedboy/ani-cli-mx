prepare_mpv_window_state_flags() {
    unset mpv_window_script_flag mpv_fullscreen_flag mpv_maximized_flag mpv_geometry_flag
    player_supports_continuous || return 0
    mpv_window_script_flag="--script=$mpv_window_state_player_script"
    continuous_enabled || return 0
    [ -s "$mpv_window_state_file" ] || return 0

    saved_fullscreen="$(sed -n 's/^fullscreen=//p' "$mpv_window_state_file" | head -n1)"
    saved_maximized="$(sed -n 's/^maximized=//p' "$mpv_window_state_file" | head -n1)"
    saved_geometry="$(sed -n 's/^geometry=//p' "$mpv_window_state_file" | head -n1)"
    case "$saved_fullscreen" in yes | no) mpv_fullscreen_flag="--fullscreen=$saved_fullscreen" ;; esac
    case "$saved_maximized" in yes | no) mpv_maximized_flag="--window-maximized=$saved_maximized" ;; esac
    case "$saved_geometry" in
        *[!0-9x]* | '' | x*) ;;
        *x*) mpv_geometry_flag="--geometry=$saved_geometry" ;;
    esac
}

persistent_mpv_supported() {
    [ "$no_detach" = "0" ] || return 1
    [ "$skip_intro" = "0" ] || return 1
    [ -z "${range:-}${start:-}${end:-}" ] || return 1
    case "$player_function" in
        mpv* | */mpv | */mpv.exe | flatpak_mpv) return 0 ;;
        *) return 1 ;;
    esac
}

persistent_mpv_alive() {
    persistent_mpv_supported || return 1
    [ -n "${player_pid:-}" ] || return 1
    kill -0 "$player_pid" 2>/dev/null
}

queue_persistent_mpv_episode() {
    persistent_mpv_alive || return 1
    command_tmp="${mpv_session_command_file}.new.$$"
    subtitles_json=""
    old_ifs=$IFS
    IFS='
'
    for subtitle_url in $(find_link_subtitles "$links" "$episode"); do
        [ -n "$subtitle_url" ] || continue
        escaped_subtitle="$(mpv_json_escape "$subtitle_url")"
        subtitles_json="${subtitles_json}${subtitles_json:+,}\"${escaped_subtitle}\""
    done
    IFS=$old_ifs

    printf '{"action":"load","episode":"%s","url":"%s","title":"%s","referrer":"%s","headers":"%s","subtitles":[%s]}\n' \
        "$(mpv_json_escape "$ep_no")" \
        "$(mpv_json_escape "$episode")" \
        "$(mpv_json_escape "${media_title}Episode ${ep_no}")" \
        "$(mpv_json_escape "${generic_refr:-}")" \
        "$(mpv_json_escape "${generic_headers:-}")" \
        "$subtitles_json" >"$command_tmp"
    rm -f "$mpv_session_event_file"
    mv "$command_tmp" "$mpv_session_command_file"
    kill -0 "$player_pid" 2>/dev/null
}

start_persistent_mpv() {
    ensure_mpv_session_files
    : >"$mpv_session_owner_file"
    rm -f "$mpv_session_command_file" "$mpv_session_event_file"
    prepare_mpv_window_state_flags
    mpv_session_log="${ANI_CLI_MPV_SESSION_LOG:-/dev/null}"
    case "$player_function" in
        flatpak_mpv)
            nohup flatpak run io.mpv.Mpv --idle=yes --keep-open=yes --force-window=immediate \
                "$mpv_window_script_flag" --script="$mpv_session_player_controller_script" \
                ${mpv_geometry_flag:-} ${mpv_maximized_flag:-} ${mpv_fullscreen_flag:-} >"$mpv_session_log" 2>&1 &
            ;;
        *)
            nohup $player_function --idle=yes --keep-open=yes --force-window=immediate \
                "$mpv_window_script_flag" --script="$mpv_session_player_controller_script" \
                ${mpv_geometry_flag:-} ${mpv_maximized_flag:-} ${mpv_fullscreen_flag:-} >"$mpv_session_log" 2>&1 &
            ;;
    esac
    player_pid=$!
    kill -0 "$player_pid" 2>/dev/null
}

play_episode() {
    manual_handoff=0
    persistent_episode_loaded=0
    persistent_mpv_alive || player_pid=""
    set_current_episode "$ep_no"
    [ "$log_episode" = 1 ] && [ "$player_function" != "debug" ] && [ "$player_function" != "download" ] && command -v logger >/dev/null && logger -t "$log_tag" "${media_title}${ep_no}"
    [ "$skip_intro" = 1 ] && skip_flag="$(ani-skip -q "$mal_id" -e "$ep_no")"
    [ -z "$episode" ] && get_episode_url
    prepare_mpv_window_state_flags
    if [ "$selected_source" = "HQQ" ] && [ "$hqq_browser_fallback" = "1" ] &&
        [ -n "$generic_refr" ] && [ "$player_function" != "debug" ] && [ "$player_function" != "download" ]; then
        printf "Fuente seleccionada: %s\n" "${selected_origin:-$selected_source}" 1>&2
        printf "HQQ requiere desbloqueo manual.\n" 1>&2
        printf "Abre esta URL:\n%s\n" "$generic_refr" 1>&2
        if open_browser_url "$generic_refr"; then
            printf "Abriendo navegador...\n" 1>&2
        fi
        manual_handoff=1
    fi
    if [ "$manual_handoff" = "0" ] && persistent_mpv_supported; then
        if persistent_mpv_alive || start_persistent_mpv; then
            if queue_persistent_mpv_episode; then
                persistent_episode_loaded=1
            else
                close_tracked_player
            fi
        fi
    fi
    # shellcheck disable=SC2086
    case "$player_function" in
        debug)
            printf "Todos los enlaces:\n%s\nFuente seleccionada:\n%s\n" "$links" "${selected_origin:-desconocida}"
            [ "$selected_source" = "HQQ" ] && [ -n "$generic_refr" ] && printf "Accion manual HQQ:\n%s\n" "$generic_refr"
            printf "Enlace seleccionado:\n"
            printf "%s\n" "$episode"
            ;;
        mpv* | */mpv | */mpv.exe)
            [ -n "$selected_origin" ] && [ "$manual_handoff" = 0 ] && printf "Fuente seleccionada: %s\n" "$selected_origin" 1>&2
            if [ "$manual_handoff" = 1 ]; then
                :
            elif [ "$persistent_episode_loaded" = "1" ]; then
                :
            elif [ "$no_detach" = 0 ]; then
                nohup $player_function $skip_flag $mpv_window_script_flag $mpv_geometry_flag $mpv_maximized_flag $mpv_fullscreen_flag --force-media-title="${media_title}Episode ${ep_no}" "$episode" $subs_flag $refr_flag $headers_flag >/dev/null 2>&1 &
                player_pid=$!
            else
                $player_function $skip_flag $mpv_window_script_flag $mpv_geometry_flag $mpv_maximized_flag $mpv_fullscreen_flag $subs_flag $refr_flag $headers_flag --force-media-title="${media_title}Episode ${ep_no}" "$episode"
                mpv_exitcode=$?
                [ "$exit_after_play" = 1 ] && [ -z "$range" ] && exit "$mpv_exitcode"
            fi
            ;;
        android_mpv) nohup am start --user 0 -a android.intent.action.VIEW -d "$episode" -n is.xyz.mpv/.MPVActivity >/dev/null 2>&1 & ;;
        android_vlc) nohup am start --user 0 -a android.intent.action.VIEW -d "$episode" -n org.videolan.vlc/org.videolan.vlc.gui.video.VideoPlayerActivity -e "title" "${media_title}Episode ${ep_no}" >/dev/null 2>&1 & ;;
        *iina*)
            [ -n "$refr_flag" ] && refr_flag="--mpv-${refr_flag#--}"
            [ -n "$headers_flag" ] && headers_flag="--mpv-${headers_flag#--}"
            if pgrep -f "IINA" >/dev/null 2>&1; then
                # omit --keep-running when an IINA instance exists to prevent hanging
                nohup $player_function --no-stdin --mpv-force-media-title="${media_title}Episode ${ep_no}" $iina_subs_flag $refr_flag $headers_flag "$episode" >/dev/null 2>&1 &
            else
                nohup $player_function --no-stdin --keep-running --mpv-force-media-title="${media_title}Episode ${ep_no}" $iina_subs_flag $refr_flag $headers_flag "$episode" >/dev/null 2>&1 &
            fi
            ;;
        flatpak_mpv)
            if [ "$persistent_episode_loaded" = "1" ]; then
                :
            elif [ "$no_detach" = 0 ]; then
                flatpak run io.mpv.Mpv $mpv_window_script_flag $mpv_geometry_flag $mpv_maximized_flag $mpv_fullscreen_flag --force-media-title="${media_title}Episode ${ep_no}" "$episode" $subs_flag $refr_flag $headers_flag >/dev/null 2>&1 &
                player_pid=$!
            else
                flatpak run io.mpv.Mpv $mpv_window_script_flag $mpv_geometry_flag $mpv_maximized_flag $mpv_fullscreen_flag --force-media-title="${media_title}Episode ${ep_no}" "$episode" $subs_flag $refr_flag $headers_flag
                mpv_exitcode=$?
                [ "$exit_after_play" = 1 ] && [ -z "$range" ] && exit "$mpv_exitcode"
            fi
            ;;
        vlc*) nohup $player_function --http-referrer="${generic_refr:-$animeflv_refr}" --play-and-exit --meta-title="${media_title}Episode ${ep_no}" "$episode" >/dev/null 2>&1 & ;;
        *yncpla*) nohup $player_function "$episode" -- --force-media-title="${media_title}Episode ${ep_no}" $subs_flag $refr_flag >/dev/null 2>&1 & ;;
        download) "$player_function" "$episode" "${media_title}Episode ${ep_no}" "$subtitle" ;;
        catt) nohup catt cast "$episode" -s "$subtitle" >/dev/null 2>&1 & ;;
        iSH)
            printf "\e]8;;vlc://%s\a~~~~~~~~~~~~~~~~~~~~\n~ Tap to open VLC ~\n~~~~~~~~~~~~~~~~~~~~\e]8;;\a\n" "$episode"
            sleep 5
            ;;
        *) nohup $player_function "$episode" >/dev/null 2>&1 & ;;
    esac
    replay="$episode"
    unset episode
    [ "$manual_handoff" = 1 ] || update_history
    [ "$manual_handoff" = 1 ] && [ "$exit_after_play" = 1 ] && [ -z "$range" ] && exit 0
    [ "$persistent_episode_loaded" = "0" ] && [ "$use_external_menu" = "1" ] && wait
    [ "$persistent_episode_loaded" = "0" ] && [ "$use_external_menu" = "2" ] && wait
}

play() {
    start=$(printf "%s" "$ep_no" | grep -Eo '^(-1|[0-9]+(\.[0-9]+)?)')
    end=$(printf "%s" "$ep_no" | grep -Eo '(-1|[0-9]+(\.[0-9]+)?)$')
    [ "$start" = "-1" ] && ep_no=$(printf "%s" "$ep_list" | tail -n1) && unset start
    [ -z "$end" ] || [ "$end" = "$start" ] && unset start end
    [ "$end" = "-1" ] && end=$(printf "%s" "$ep_list" | tail -n1)
    line_count=$(printf "%s\n" "$ep_no" | wc -l | tr -d "[:space:]")
    if [ "$line_count" != 1 ] || [ -n "$start" ]; then
        [ -z "$start" ] && start=$(printf "%s\n" "$ep_no" | head -n1)
        [ -z "$end" ] && end=$(printf "%s\n" "$ep_no" | tail -n1)
        range=$(printf "%s\n" "$ep_list" | sed -nE "/^${start}\$/,/^${end}\$/p")
        [ -z "$range" ] && die "Invalid range!"
        for i in $range; do
            tput clear
            ep_no=$i
            printf "\33[2K\r\033[1;34mReproduciendo episodio %s...\033[0m\n" "$ep_no"
            [ "$i" = "$end" ] && unset range
            play_episode
        done
    else
        play_episode
    fi
    # moves up to stored position and deletes to end
    [ "$player_function" != "debug" ] && [ "$player_function" != "download" ] && tput rc && tput ed
}

set_current_episode() {
    [ -n "$1" ] && printf '%s\n' "$1" >"$current_episode_file"
}

current_episode_number() {
    if [ -s "$current_episode_file" ]; then
        sed -n '1p' "$current_episode_file"
    else
        printf '%s\n' "$ep_no"
    fi
}

sync_current_episode() {
    synced_ep="$(current_episode_number)"
    [ -n "$synced_ep" ] && ep_no="$synced_ep"
}

next_episode_number() {
    current_ep="${1:-$ep_no}"
    printf "%s\n" "$ep_list" | sed -n "/^${current_ep}$/{n;p;}" | head -n1
}

play_continuous() {
    while next_ep="$(next_episode_number "$(current_episode_number)")" && [ -n "$next_ep" ]; do
        ep_no="$next_ep"
        set_current_episode "$ep_no"
        printf "\33[2K\r\033[1;34mReproduciendo episodio %s...\033[0m\n" "$ep_no"
        play_episode
    done
    printf "No hay mas episodios disponibles.\n" 1>&2
}

player_supports_continuous() {
    case "$player_function" in
        mpv* | */mpv | mpv.exe | */mpv.exe | flatpak_mpv) return 0 ;;
        *) return 1 ;;
    esac
}

continuous_enabled() {
    [ -f "$continuous_state_file" ] && grep -qx "1" "$continuous_state_file"
}

set_continuous_mode() {
    continuous_mode="$1"
    printf '%s\n' "$1" >"$continuous_state_file"
}

disable_continuous_mode() {
    set_continuous_mode 0
    stop_continuous_worker
}

stop_continuous_worker() {
    [ -n "${continuous_worker_pid:-}" ] && kill "$continuous_worker_pid" 2>/dev/null || true
    [ -n "${continuous_worker_pid:-}" ] && wait "$continuous_worker_pid" 2>/dev/null || true
    continuous_worker_pid=""
}

close_previous_enabled() {
    [ "$close_previous_player" = "1" ]
}

set_close_previous_mode() {
    close_previous_player="$1"
}

close_tracked_player() {
    [ -n "${player_pid:-}" ] || return 0
    kill -0 "$player_pid" 2>/dev/null || return 0
    kill "$player_pid" 2>/dev/null || true
    wait "$player_pid" 2>/dev/null || true
    player_pid=""
}

prepare_for_menu_playback() {
    stop_continuous_worker
    if close_previous_enabled; then
        close_tracked_player
    fi
}

start_continuous_worker_for_current_player() {
    continuous_enabled || return 1
    player_supports_continuous || return 1
    [ -n "${player_pid:-}" ] || return 1
    kill -0 "$player_pid" 2>/dev/null || return 1

    stop_continuous_worker
    continuous_worker_loop "$player_pid" &
    continuous_worker_pid=$!
    return 0
}

wait_for_pid_to_exit() {
    [ -n "$1" ] || return 0
    while kill -0 "$1" 2>/dev/null; do
        sleep 1
    done
}

wait_for_persistent_episode_end() {
    watched_pid="$1"
    while kill -0 "$watched_pid" 2>/dev/null; do
        if [ -s "$mpv_session_event_file" ]; then
            ended_ep="$(sed -n '1p' "$mpv_session_event_file")"
            rm -f "$mpv_session_event_file"
            [ "$ended_ep" = "$(current_episode_number)" ] && return 0
        fi
        sleep 0.2
    done
    return 0
}

continuous_worker_loop() {
    watched_pid="$1"
    if persistent_mpv_alive; then
        wait_for_persistent_episode_end "$watched_pid"
    else
        wait_for_pid_to_exit "$watched_pid"
    fi
    while continuous_enabled; do
        next_ep="$(next_episode_number "$(current_episode_number)")"
        if [ -z "$next_ep" ]; then
            set_continuous_mode 0
            printf "No hay mas episodios disponibles.\n" 1>&2
            return 0
        fi

        ep_no="$next_ep"
        set_current_episode "$ep_no"
        printf "\33[2K\r\033[1;34mReproduciendo episodio %s...\033[0m\n" "$ep_no"
        play_episode
        if persistent_mpv_alive; then
            wait_for_persistent_episode_end "$player_pid"
        else
            wait_for_pid_to_exit "${player_pid:-}"
        fi
    done
}

toggle_continuous_mode_from_menu() {
    if continuous_enabled; then
        disable_continuous_mode
        printf "Modo continuo desactivado.\n" 1>&2
        return 0
    fi

    if ! player_supports_continuous; then
        printf "Modo continuo requiere mpv para detectar cuando termina el episodio\n" 1>&2
        return 1
    fi

    set_continuous_mode 1
    if start_continuous_worker_for_current_player; then
        printf "Modo continuo activado. El siguiente capitulo se cargara en la misma ventana de mpv al terminar.\n" 1>&2
    else
        printf "Modo continuo activado. El proximo capitulo que reproduzcas avanzara automaticamente al terminar o cerrar el reproductor.\n" 1>&2
    fi
}

toggle_close_previous_from_menu() {
    if close_previous_enabled; then
        set_close_previous_mode 0
        printf "Cerrar reproductor anterior desactivado.\n" 1>&2
    else
        set_close_previous_mode 1
        printf "Cerrar reproductor anterior activado. Al abrir otro episodio desde el menu, se cerrara el reproductor observado anterior.\n" 1>&2
    fi
}

playback_menu_options() {
    printf "siguiente\nanterior\nrepetir_episodio_actual\nelegir_episodio\ndescargar_episodio_actual\n"
    if continuous_enabled; then
        printf "desactivar_modo_continuo\n"
    else
        printf "activar_modo_continuo\n"
    fi
    if close_previous_enabled; then
        printf "desactivar_cerrar_reproductor_anterior\n"
    else
        printf "activar_cerrar_reproductor_anterior\n"
    fi
    printf "salir\n"
}

playback_menu_prompt() {
    menu_ep="$(current_episode_number)"
    if continuous_enabled; then
        playback_mode="continuo"
        playback_note="el proximo capitulo reproducido avanzara automaticamente"
